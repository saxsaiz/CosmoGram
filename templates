<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101114">
<title>Lime GRAM — Проверка</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;background:#101114;color:#fff}
body{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.card{width:min(100%,390px);padding:28px 22px 24px;border:1px solid #2c2d32;border-radius:24px;background:#17181c;box-shadow:0 16px 50px rgba(0,0,0,.35);text-align:center}
.logo{width:68px;height:68px;margin:0 auto 18px;border-radius:18px;background:#b8ff38;color:#101114;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:900;box-shadow:0 0 28px rgba(184,255,56,.18)}
h1{margin:0;font-size:25px}
.sub{margin:9px 0 24px;color:#999ca5;font-size:14px;line-height:1.45}
.status{min-height:54px;padding:15px;border-radius:14px;background:#101114;color:#c9cbd0;font-size:15px;line-height:1.4}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid #555;border-top-color:#b8ff38;border-radius:50%;vertical-align:-3px;margin-right:8px;animation:spin .8s linear infinite}
.ok{color:#b8ff38}.bad{color:#ff6262}.warn{color:#ffc857}
.small{margin-top:16px;color:#666a73;font-size:11px;line-height:1.4}
button{display:none;margin-top:16px;width:100%;border:0;border-radius:13px;padding:13px;background:#b8ff38;color:#101114;font-weight:700}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="card">
  <div class="logo">LG</div>
  <h1>Проверка аккаунта</h1>
  <div class="sub">Lime GRAM проверяет Telegram-аккаунт и IP-адрес устройства.</div>
  <div id="status" class="status"><span class="spinner"></span>Проверяем…</div>
  <button id="close" onclick="Telegram.WebApp.close()">Закрыть</button>
  <div class="small">IP-адрес не показывается на экране и хранится в виде хеша.</div>
</div>
<script>
const tg = window.Telegram && window.Telegram.WebApp;
const statusEl = document.getElementById('status');
const closeBtn = document.getElementById('close');

if (tg) {
  tg.ready();
  tg.expand();
}

async function checkAccount(){
  if (!tg || !tg.initData) {
    statusEl.className = 'status warn';
    statusEl.textContent = '⚠️ Откройте эту страницу через Telegram WebApp.';
    return;
  }

  try {
    const response = await fetch('/api/check', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({initData:tg.initData})
    });

    const data = await response.json();

    if (data.blocked) {
      statusEl.className = 'status bad';
      statusEl.textContent = '⛔ Доступ заблокирован. Обратитесь к администратору.';
      closeBtn.style.display = 'block';
      return;
    }

    if (!response.ok || !data.ok) {
      statusEl.className = 'status warn';
      statusEl.textContent = '⚠️ Не удалось выполнить проверку. Попробуйте ещё раз.';
      closeBtn.style.display = 'block';
      return;
    }

    statusEl.className = 'status ok';
    statusEl.textContent = '✅ Проверка аккаунта пройдена.';
    setTimeout(() => tg.close(), 900);
  } catch (error) {
    statusEl.className = 'status warn';
    statusEl.textContent = '⚠️ Ошибка соединения с сервером.';
    closeBtn.style.display = 'block';
  }
}

checkAccount();
</script>
</body>
</html>

